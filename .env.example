# ENCRYPTION_KEY is optional.
# If not set, a key is auto-generated and saved to encryption.key in the data directory.
#
# To set manually (e.g. to share the same key across multiple containers):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Then paste the output below.

ENCRYPTION_KEY=

# INTERNAL_DNS: IP ของ DNS server ภายในองค์กร
# จำเป็นเมื่อใช้ hostname ภายใน เช่น mailgateway.company.local
# หากไม่ระบุ จะใช้ 8.8.8.8 (Google DNS) ซึ่ง resolve internal hostname ไม่ได้
#
# ตัวอย่าง: INTERNAL_DNS=192.168.1.1

INTERNAL_DNS=
