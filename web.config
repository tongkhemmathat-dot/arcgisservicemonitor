<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>

        <!-- Serve index.html as default document -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.html" />
            </files>
        </defaultDocument>

        <!-- Proxy /api/* → Python backend on 127.0.0.1:8000 -->
        <!-- Requires: IIS URL Rewrite + ARR modules -->
        <rewrite>
            <rules>
                <rule name="Proxy to Python API" stopProcessing="true">
                    <match url="^api/(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:8000/api/{R:1}" />
                </rule>
            </rules>
        </rewrite>

        <!-- Security headers -->
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
            </customHeaders>
        </httpProtocol>

        <!-- Cache static assets -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:10:00" />
        </staticContent>

    </system.webServer>
</configuration>
